		{
			"why": "a correction that inserts other words",
			"term": {
				"term": "VTXO",
				"corrections": [
					{
						"match": "\\bno\\b",
						"replace": "yes"
					}
				]
			}
		},
		{
			"why": "lookbehind is not portable",
			"term": {
				"term": "Ark",
				"corrections": [
					{
						"match": "(?<=the )arc",
						"replace": "Ark"
					}
